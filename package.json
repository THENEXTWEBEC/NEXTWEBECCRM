{
  "name": "nextwebeccrm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "build": "npm run check",
    "migrate": "node server/migrate.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "backup": "node scripts/backup.mjs",
    "check": "node --check server/index.mjs && node --check server/db.mjs && node --check src/app.js && node --check src/api.js && node --check scripts/create-admin.mjs && node --check scripts/backup.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0"
  }
}
