# Public values only. Never add a Supabase service_role key to this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Supabase injects this into Edge Functions by default. Server-side only; never use in browser builds.
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
